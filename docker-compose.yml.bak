services:
  # =============================================================================
  # 🗄️ SQL Server 2022
  # =============================================================================
  sqlserver:
    image: mcr.microsoft.com/mssql/server:2022-latest
    container_name: sistemaventa-sqlserver
    environment:
      ACCEPT_EULA: "Y"
      MSSQL_SA_PASSWORD: "${MSSQL_SA_PASSWORD}"
      MSSQL_PID: "Developer"
    ports:
      - "1433:1433"
    volumes:
      - sqldata:/var/opt/mssql
    healthcheck:
      test: ["CMD-SHELL", "/opt/mssql-tools18/bin/sqlcmd -S localhost -U sa -P \"$${MSSQL_SA_PASSWORD}\" -Q \"SELECT 1\" -C || exit 1"]
      interval: 10s
      retries: 10
      start_period: 30s
      timeout: 5s
    networks:
      - sistemaventa-net

  # =============================================================================
  # 🧩 Inicialización de Base de Datos
  # =============================================================================
  db-init:
    image: mcr.microsoft.com/mssql/server:2022-latest
    container_name: sistemaventa-db-init
    depends_on:
      sqlserver:
        condition: service_healthy
    environment:
      MSSQL_SA_PASSWORD: "${MSSQL_SA_PASSWORD}"
    volumes:
      - ./database/reset/99-reset-db.sql:/scripts/01-create-db.sql:ro
    command: >
      /bin/bash -c '
      echo "Ejecutando script de inicialización de base de datos...";
      /opt/mssql-tools18/bin/sqlcmd -S sqlserver,1433 -U sa -P "$${MSSQL_SA_PASSWORD}" -C -b -i /scripts/01-create-db.sql;
      echo "Inicialización finalizada.";
      '
    restart: "no"
    networks:
      - sistemaventa-net

  # =============================================================================
  # ⚙️ API .NET 10
  # =============================================================================
  api:
    build:
      context: .
      dockerfile: Dockerfile
    container_name: sistemaventa-api
    ports:
      - "8080:8080"
    environment:
      ASPNETCORE_ENVIRONMENT: "Development"
      ASPNETCORE_URLS: "http://+:8080"
      DOTNET_SYSTEM_GLOBALIZATION_INVARIANT: "false"
      ConnectionStrings__cadenaSQL: "Server=sqlserver,1433;Database=DBVENTAngular;User Id=sa;Password=${MSSQL_SA_PASSWORD};TrustServerCertificate=True;Encrypt=False"
      Jwt__Key: "${JWT_KEY}"
      Jwt__Issuer: "SistemaVentaAPI"
      Jwt__Audience: "SistemaVentaClient"
    depends_on:
      sqlserver:
        condition: service_healthy
      db-init:
        condition: service_completed_successfully
    restart: on-failure
    networks:
      - sistemaventa-net

  # =============================================================================
  # 🌐 Frontend Angular 16 + Nginx
  # =============================================================================
  frontend:
    build:
      context: ../AppSistemaVenta
      dockerfile: Dockerfile
    container_name: sistemaventa-frontend
    ports:
      - "4200:80"
    depends_on:
      - api
    restart: on-failure
    networks:
      - sistemaventa-net

networks:
  sistemaventa-net:
    driver: bridge

volumes:
  sqldata:
    driver: local
